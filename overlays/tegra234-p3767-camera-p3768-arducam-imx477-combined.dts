// SPDX-License-Identifier: GPL-2.0-only
// Combined camera overlay: IMX477 (2-lane, CAM0/port B) + AR0234 stereo (4-lane, CAM1/port C)
// For Jetson Orin Nano / Orin Nano Super (p3768 carrier + p3767-0003/0004/0005),
// L4T R36.x (JetPack 6.2) and R39.2 (JetPack 7.2) with Arducam's arducam_4lane
// driver package. Verified on both: IMX477 1080p30, AR0234 3840x1200@30.
//
// IMX477 on i2c@0 / CSI port B (serial_b, port-index 1) - 2 lanes, NVIDIA nv_imx477 driver
// AR0234 on i2c@1 / CSI port C (serial_c, port-index 2) - 4 lanes, Arducam arducam_csi2 driver
//
// Only CAM1 (J21) is wired for 4 lanes on the p3768 carrier, so the stereo board
// must sit on CAM1. The IMX477 node and modes match NVIDIA's
// tegra234-p3767-camera-p3768-imx477-A.dtbo; the AR0234 node is the one from
// tegra234-p3767-camera-p3768-arducam-imx219-combined.dts. i2c@1 carries
// reg = <1> so the two mux channels stay separate.

/dts-v1/;
/plugin/;

/ {
	overlay-name = "Camera AR0234 + IMX477 Combined";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = "nvidia,p3768-0000+p3767-0000", "nvidia,p3768-0000+p3767-0001",
		     "nvidia,p3768-0000+p3767-0003", "nvidia,p3768-0000+p3767-0004",
		     "nvidia,p3768-0000+p3767-0005",
		     "nvidia,p3768-0000+p3767-0000-super", "nvidia,p3768-0000+p3767-0001-super",
		     "nvidia,p3768-0000+p3767-0003-super", "nvidia,p3768-0000+p3767-0004-super",
		     "nvidia,p3768-0000+p3767-0005-super";

	fragment@0 {
		target-path = "/";

		__overlay__ {

			tegra-capture-vi {
				num-channels = <2>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					/* IMX477 on CSI port B (2-lane) */
					port@0 {
						reg = <0>;

						rbpcv3_imx477_vi_in0: endpoint {
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&rbpcv3_imx477_csi_out0>;
						};
					};

					/* AR0234 on CSI port C (4-lane) */
					port@1 {
						reg = <1>;

						arducam_vi_in1: endpoint {
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&arducam_csi_out1>;
						};
					};
				};
			};

			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				num_csi_lanes = <6>;
				max_lane_speed = <1500000>;
				min_bits_per_pixel = <10>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				max_pixel_rate = <7500000>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;

				modules {

					module0 {
						badge = "jakku_front_RBPCV3";
						position = "front";
						orientation = "1";

						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/rbpcv3_imx477_a@1a";
						};
					};

					module1 {
						badge = "jakku_rear_arducam";
						position = "rear";
						orientation = "1";

						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/arducam_c@0c";
						};
					};
				};
			};

			bus@0 {

				host1x@13e00000 {

					nvcsi@15a00000 {
						num-channels = <2>;
						#address-cells = <1>;
						#size-cells = <0>;

						/* Channel 0: IMX477 on CSI port B, 2-lane */
						channel@0 {
							reg = <0>;

							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									rbpcv3_imx477_csi_in0: endpoint@0 {
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&rbpcv3_imx477_out0>;
									};
								};

								port@1 {
									reg = <1>;

									rbpcv3_imx477_csi_out0: endpoint@1 {
										remote-endpoint = <&rbpcv3_imx477_vi_in0>;
									};
								};
							};
						};

						/* Channel 1: AR0234 on CSI port C, 4-lane */
						channel@1 {
							reg = <1>;

							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									arducam_csi_in1: endpoint@2 {
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&arducam_out1>;
									};
								};

								port@1 {
									reg = <1>;

									arducam_csi_out1: endpoint@3 {
										remote-endpoint = <&arducam_vi_in1>;
									};
								};
							};
						};
					};
				};

				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					mux-gpios = <&gpio_aon 0x13 0x00>;
					i2c-parent = <&cam_i2c>;

					i2c@0 {
						status = "okay";
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;

						rbpcv2_imx219_a@10 {
							status = "disabled";
						};

						rbpcv3_imx477_a@1a {
							reset-gpios = <&gpio 0x3e 0x00>;
							compatible = "ridgerun,imx477";
							reg = <0x1a>;
							devnode = "video0";
							physical_w = "3.680";
							physical_h = "2.760";
							sensor_model = "imx477";
							use_sensor_mode_id = "true";

							mode0 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "6";
								active_w = "3840";
								active_h = "2160";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "11200";
								inherent_gain = "1";
								mclk_multiplier = "80";
								pix_clk_hz = "300000000";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "356";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "30000000";
								step_framerate = "1";
								default_framerate = "30000000";
								min_exp_time = "13";
								max_exp_time = "683709";
								step_exp_time = "1";
								default_exp_time = "2495";
								embedded_metadata_height = "2";
							};

							mode1 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "6";
								active_w = "1920";
								active_h = "1080";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "7000";
								inherent_gain = "1";
								mclk_multiplier = "80";
								pix_clk_hz = "300000000";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "356";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "60000000";
								step_framerate = "1";
								default_framerate = "60000000";
								min_exp_time = "13";
								max_exp_time = "683709";
								step_exp_time = "1";
								default_exp_time = "2495";
								embedded_metadata_height = "2";
							};

							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									rbpcv3_imx477_out0: endpoint {
										status = "okay";
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&rbpcv3_imx477_csi_in0>;
									};
								};
							};
						};
					};

					i2c@1 {
						status = "okay";
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;

						rbpcv2_imx219_c@10 {
							status = "disabled";
						};

						arducam_c@0c {
							reset-gpios = <&gpio 0xa0 0x00>;
							compatible = "arducam,arducam-csi2";
							reg = <0x0c>;
							devnode = "video1";
							physical_w = "5.760";
							physical_h = "3.600";
							sensor_model = "arducam-csi2";
							use_sensor_mode_id = "true";

							mode0 {
								mclk_khz = "24000";
								num_lanes = "4";
								tegra_sinterface = "serial_c";
								phy_mode = "DPHY";
								discontinuous_clk = "yes";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "0";
								active_w = "3840";
								active_h = "1200";
								mode_type = "bayer";
								pixel_phase = "grbg";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "4400";
								inherent_gain = "1";
								mclk_multiplier = "6.67";
								/* NVCSI derives the D-PHY lane rate, and from it the HS settle
								 * (sync) window, from pix_clk_hz. 154 MHz (385 Mbps/lane) is the
								 * value this board streamed with on L4T R36 in VisionSense; keep
								 * it matched to the board so the receiver locks onto its bursts. */
								pix_clk_hz = "154000000";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "170";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "30000000";
								step_framerate = "1";
								default_framerate = "30000000";
								min_exp_time = "13";
								max_exp_time = "683709";
								step_exp_time = "1";
								default_exp_time = "2495";
								embedded_metadata_height = "0";
							};

							ports {
								#address-cells = <1>;
								#size-cells = <0>;

								port@0 {
									reg = <0>;

									arducam_out1: endpoint {
										status = "okay";
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&arducam_csi_in1>;
									};
								};
							};
						};
					};
				};

				gpio@6000d000 {

					camera-control-output-low {
						gpio-hog;
						output-low;
						gpios = <0xa0 0x00 0x3e 0x00>;
						label = "cam1-pwdn\0cam0-pwdn";
					};
				};
			};
		};
	};
};
